# HOSU 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
#   cp .env.example .env
#
# 키가 하나도 없어도 파이프라인·MCP 서버·대시보드는 전부 정상 동작합니다.
# data/raw/ 에 정규화된 공공데이터 CSV가 이미 포함돼 있기 때문입니다.

# ─────────────────────────────────────────────────────────────
# 실행 시 사용 (선택)
# ─────────────────────────────────────────────────────────────

# Claude API 키 — 대시보드 상단 "오늘의 브리핑" 생성에만 사용합니다.
# https://console.anthropic.com/settings/keys
#
# 없으면: 규칙 기반 문장으로 자동 대체됩니다(숫자는 동일, 문장만 투박해짐).
#         지도·위험도·MCP 서버 등 나머지 기능은 전혀 영향받지 않습니다.
ANTHROPIC_API_KEY=

# 기상청 초단기실황 API 인증키 (공공데이터포털 발급)
# https://www.data.go.kr/data/15084084/openapi.do
#
# 없으면: data/raw/gyeongbuk_weather.csv 의 실측 스냅샷을 사용하며,
#         그마저 없는 격자는 결정론적 폴백값으로 대체합니다.
# 있으면: 캐시에 없는 격자를 조회할 때 실시간 실황을 호출합니다.
#
# 공공데이터포털의 "인증키(Encoding)" / "(Decoding)" 어느 쪽을 넣어도 됩니다
# (mcp_server/weather.py 가 unquote 로 이중 인코딩을 방지합니다).
KMA_API_KEY=

# 위 값이 비어있을 때 대신 참조하는 공공데이터포털 공용 인증키.
# 여러 data.go.kr API를 하나의 키로 쓰는 경우 여기에만 넣어도 됩니다.
DATA_GO_KR_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# 원본 데이터 수집 시 사용 (재현용, 평소에는 불필요)
# ─────────────────────────────────────────────────────────────
# 아래 키들은 data/raw/ 의 CSV를 처음 만들 때 쓴 것으로,
# 이미 가공된 결과물이 리포에 포함돼 있어 실행에는 필요하지 않습니다.
# 원본부터 다시 수집하려는 경우에만 채우세요.

# 행정안전부 생활안전지도 무더위쉼터 (shelters.csv 원본)
SAFEMAP_SERVICE_KEY=

# 지자체 인구 통계 API (population.csv 원본)
POHANG_POPULATION_API_KEY=
