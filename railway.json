{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python song/1_data_infrastructure/pipeline/build.py && gunicorn --chdir song/2_regional_service app:app --bind 0.0.0.0:$PORT --timeout 120 --workers 2",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
